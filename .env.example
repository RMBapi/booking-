# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/booking_db?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────
# Required, ≥32 chars in production. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-strong-secret"
# Optional access-token TTL override (default 15m). Format: 15m / 1h / 7d.
ACCESS_TOKEN_TTL="15m"

# ─── Server ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated allow-list of frontend origins (required in production).
# Without this, CORS reflects the request origin (dev only).
CORS_ORIGIN="http://localhost:3000"
# Body size limit for JSON / urlencoded payloads.
BODY_LIMIT="1mb"
# Public-facing frontend URL — used to build invitation/activation links.
FRONTEND_URL="http://localhost:3000"

# ─── File uploads (Supabase Storage) ────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=5242880
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# ─── Mail ────────────────────────────────────────────────────────────
# 'resend' | (empty/anything else uses the dev console adapter)
MAIL_DRIVER=""
RESEND_API_KEY=""
MAIL_FROM="Cuebites <noreply@notifications.cuebites.com.au>"

# ─── Seeding ─────────────────────────────────────────────────────────
# Optional. When both are set, `npx prisma db seed` upserts a Super_Admin.
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""
