generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  google
}

enum ServiceStatus {
  Active
  Inactive
  Archived
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

enum ConfirmationMethod {
  Email
  SMS
  Phone
  None
}

enum BookingSource {
  Website
  Phone
  WalkIn
  Mobile
  CRM
}

enum MemberStatus {
  Pending
  Active
  Deactivated
}

model Business {
  id          String    @id @default(uuid())
  name        String
  description String?
  logo        String?
  image       String?
  email       String?
  phone       String?
  address     String?
  slug        String    @unique
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userBusinesses   UserBusiness[]
  businessServices BusinessService[]
  serviceProviders ServiceProvider[]
  contacts         Contact[]
  bookings         Booking[]
  businessSites    BusinessSite[]
  reviews          Review[]
  userPermissions  UserPermission[]

  @@map("businesses")
}

model User {
  id                     String    @id @default(uuid())
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  phone                  String
  email                  String
  passwordHash           String    @map("password_hash")
  isActive               Boolean   @default(true) @map("is_active")
  systemRole             String    @default("Customer") @map("system_role")
  passwordChangeRequired Boolean   @default(false) @map("password_change_required")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  userBusinesses        UserBusiness[]
  userOAuths            UserOAuth[]
  serviceProviders      ServiceProvider[]
  contactUsers          ContactUser[]
  bookings              Booking[]
  customerBusinessSites CustomerBusinessSite[]
  reviews               Review[]
  userPermissions       UserPermission[]

  @@map("users")
}

model UserBusiness {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  businessId String       @map("business_id")
  role       String       @default("Service_Provider")
  status     MemberStatus @default(Active)
  createdAt  DateTime     @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("user_businesses")
}

model UserPermission {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  businessId String   @map("business_id")
  permission String
  grantedAt  DateTime @default(now()) @map("granted_at")
  grantedBy  String   @map("granted_by")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId, permission])
  @@index([userId, businessId])
  @@map("user_permission")
}

model UserOAuth {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  email          String
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("user_oauths")
}

model Service {
  id                          String        @id @default(uuid())
  name                        String
  description                 String?
  price                       Decimal       @db.Decimal(10, 2)
  status                      ServiceStatus
  priceDisplayMode            Boolean       @default(false) @map("price_display_mode")
  allowCustomerChooseProvider Boolean       @default(false) @map("allow_customer_choose_provider")
  isActive                    Boolean       @default(true) @map("is_active")
  createdAt                   DateTime      @default(now()) @map("created_at")
  updatedAt                   DateTime      @updatedAt @map("updated_at")
  deletedAt                   DateTime?     @map("deleted_at")

  businessServices BusinessService[]
  serviceProviders ServiceProvider[]
  schedulers       Scheduler[]
  contacts         Contact[]
  bookings         Booking[]

  @@map("services")
}

model BusinessService {
  id         String @id @default(uuid())
  businessId String @map("business_id")
  serviceId  String @map("service_id")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([businessId, serviceId])
  @@map("business_services")
}

model ServiceProvider {
  id          String    @id @default(uuid())
  businessId  String    @map("business_id")
  serviceId   String    @map("service_id")
  userId      String    @map("user_id")
  description String?
  impUrl      String?   @map("imp_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("service_providers")
}

model Scheduler {
  id              String @id @default(uuid())
  serviceId       String @map("service_id")
  canScheduleTime Json   @map("can_schedule_time")

  // Relations
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("schedulers")
}

model Contact {
  id          String    @id @default(uuid())
  businessId  String    @map("business_id")
  serviceId   String    @map("service_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  bookingTime Json?     @map("booking_time")
  email       String
  phone       String
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  contactUsers ContactUser[]

  @@map("contacts")
}

model ContactUser {
  id        String @id @default(uuid())
  contactId String @map("contact_id")
  userId    String @map("user_id")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, userId])
  @@map("contact_users")
}

model Booking {
  id                 String             @id @default(uuid())
  businessId         String             @map("business_id")
  userId             String?            @map("user_id")
  serviceId          String             @map("service_id")
  serviceProviderId  String?            @map("service_provider_id")
  bookingTime        Json?
  status             BookingStatus
  confirmationMethod ConfirmationMethod @map("confirmation_method")
  customerNotes      String?            @map("customer_notes") @db.Text
  bookingSource      BookingSource      @map("booking_source")
  guestFirstName     String?            @map("guest_first_name")
  guestLastName      String?            @map("guest_last_name")
  guestEmail         String?            @map("guest_email")
  guestPhone         String?            @map("guest_phone")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason") @db.Text

  // Relations
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider? @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  review          Review?

  @@map("bookings")
}

model Review {
  id         String    @id @default(uuid())
  bookingId  String    @unique @map("booking_id")
  userId     String    @map("user_id")
  businessId String    @map("business_id")
  rating     Int
  comment    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@map("reviews")
}

model BusinessSite {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  name       String
  slug       String
  domain     String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerBusinessSites CustomerBusinessSite[]

  @@unique([businessId, slug])
  @@map("business_sites")
}

model CustomerBusinessSite {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  businessSiteId String @map("business_site_id")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessSite BusinessSite @relation(fields: [businessSiteId], references: [id], onDelete: Cascade)

  @@unique([userId, businessSiteId])
  @@map("customer_business_sites")
}

/// Pending invitation to join a business as an owner/staff member.
/// Token is stored as sha256 hash; raw token is shown only at creation time.
model BusinessInvitation {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  email      String
  role       String    @default("Business_owner") // role to grant on accept
  invitedBy  String    @map("invited_by") // userId of inviter
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  acceptedBy String?   @map("accepted_by") // userId who accepted (may differ from email-target if account changes)
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([businessId])
  @@index([email])
  @@map("business_invitations")
}

/// Refresh tokens. Stored as sha256 hash; raw value lives only in the
/// httpOnly cookie sent to the client.
///
/// Rotation: every successful refresh marks the presented token as
/// `revokedAt = now()` and `replacedById = <new token id>`, then issues a
/// fresh row. `familyId` groups the entire chain produced from a single
/// login. Reuse detection: if a token whose `revokedAt` is non-null is
/// presented, every row with the same `familyId` is revoked (someone
/// replayed an old token — assume compromise).
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Dead-letter table: emails that exhausted retry attempts.
/// Inspect periodically and replay or discard.
model FailedEmail {
  id       String   @id @default(uuid())
  toEmail  String   @map("to_email")
  template String // e.g. "invitation"
  payload  Json // template-specific render context
  error    String // last error message
  attempts Int      @default(1)
  failedAt DateTime @default(now()) @map("failed_at")

  @@index([template])
  @@index([failedAt])
  @@map("failed_emails")
}
