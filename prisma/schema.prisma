generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  google
}

enum ServiceStatus {
  Active
  Inactive
  Archived
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

enum ConfirmationMethod {
  Email
  SMS
  Phone
  None
}

enum BookingSource {
  Website
  Phone
  WalkIn
  Mobile
}

model Business {
  id          String    @id @default(uuid())
  name        String
  description String?
  logoUrl     String?   @map("logo_url")
  email       String?
  phone       String?
  address     String?
  slug        String    @unique
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userBusinesses   UserBusiness[]
  businessServices BusinessService[]
  serviceProviders ServiceProvider[]
  contacts         Contact[]
  bookings         Booking[]
  businessSites    BusinessSite[]

  @@map("businesses")
}

model User {
  id           String            @id @default(uuid())
  firstName    String            @map("first_name")
  lastName     String            @map("last_name")
  phone        String
  email        String
  passwordHash String            @map("password_hash")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  userRoles             UserRole[]
  userBusinesses        UserBusiness[]
  userOAuths            UserOAuth[]
  serviceProviders      ServiceProvider[]
  contactUsers          ContactUser[]
  bookings              Booking[]
  customerBusinessSites CustomerBusinessSite[]

  @@map("users")
}

model UserBusiness {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  businessId String   @map("business_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("user_businesses")
}

model UserOAuth {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  email          String
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("user_oauths")
}

model Service {
  id              String        @id @default(uuid())
  name            String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  status          ServiceStatus
  priceDisplayMode Boolean      @default(false) @map("price_display_mode")
  allowCustomerChooseProvider Boolean @default(false) @map("allow_customer_choose_provider")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  businessServices BusinessService[]
  serviceProviders ServiceProvider[]
  schedulers       Scheduler[]
  contacts         Contact[]
  bookings         Booking[]

  @@map("services")
}

model BusinessService {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  serviceId   String   @map("service_id")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([businessId, serviceId])
  @@map("business_services")
}

model ServiceProvider {
  id          String    @id @default(uuid())
  businessId  String    @map("business_id")
  serviceId   String    @map("service_id")
  userId      String    @map("user_id")
  description String?
  impUrl      String?   @map("imp_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("service_providers")
}

model Scheduler {
  id              String   @id @default(uuid())
  serviceId       String   @map("service_id")
  canScheduleTime Json     @map("can_schedule_time")

  // Relations
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("schedulers")
}

model Contact {
  id          String    @id @default(uuid())
  businessId  String    @map("business_id")
  serviceId   String    @map("service_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  bookingTime Json?     @map("booking_time")
  email       String
  phone       String
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  contactUsers ContactUser[]

  @@map("contacts")
}

model ContactUser {
  id        String  @id @default(uuid())
  contactId String  @map("contact_id")
  userId    String  @map("user_id")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, userId])
  @@map("contact_users")
}

model Booking {
  id                 String            @id @default(uuid())
  businessId         String            @map("business_id")
  userId             String            @map("user_id")
  serviceId          String            @map("service_id")
  serviceProviderId  String?           @map("service_provider_id")
  bookingTime        Json?
  status             BookingStatus
  confirmationMethod ConfirmationMethod @map("confirmation_method")
  customerNotes      String?           @db.Text @map("customer_notes")
  bookingSource      BookingSource     @map("booking_source")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @db.Text @map("cancellation_reason")

  // Relations
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider? @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

model BusinessSite {
  id          String    @id @default(uuid())
  businessId  String    @map("business_id")
  name        String
  slug        String
  domain      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerBusinessSites CustomerBusinessSite[]

  @@unique([businessId, slug])
  @@map("business_sites")
}

model CustomerBusinessSite {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  businessSiteId String       @map("business_site_id")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessSite BusinessSite @relation(fields: [businessSiteId], references: [id], onDelete: Cascade)

  @@unique([userId, businessSiteId])
  @@map("customer_business_sites")
}

/// Dynamic role entity — replaces the hard-coded UserRole enum for auth/permission logic.
/// Seeded with Customer, Service_Provider, Business_owner, Super_Admin on first deploy.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// Join table: User ↔ Role (replaces User.roles enum array for all new logic).
model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

/// Fine-grained capability (e.g. user:update). Assigned to Role via RolePermission.
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Many-to-many: which Role rows grant which Permission rows.
/// Migrated from enum-keyed RolePermission — see migration Phase 2.
model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}
