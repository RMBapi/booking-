generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Customer
  Service_Provider
  Business_owner
  Super_Admin
}

enum OAuthProvider {
  google
}

enum ServiceStatus {
  Active
  Inactive
  Archived
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

enum ConfirmationMethod {
  Email
  SMS
  Phone
  None
}

enum BookingSource {
  Website
  Phone
  WalkIn
  Mobile
}

model Business {
  id          String    @id @default(uuid())
  name        String
  description String?
  logoUrl     String?   @map("logo_url")
  email       String?
  phone       String?
  address     String?
  slug        String    @unique
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userBusinesses    UserBusiness[]
  businessServices  BusinessService[]
  serviceProviders  ServiceProvider[]
  contacts          Contact[]
  bookings          Booking[]

  @@map("businesses")
}

model User {
  id           String     @id @default(uuid())
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String
  email        String
  roles        UserRole[]
  passwordHash String     @map("password_hash")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  userBusinesses   UserBusiness[]
  userOAuths       UserOAuth[]
  serviceProviders ServiceProvider[]
  contactUsers     ContactUser[]
  bookings         Booking[]

  @@map("users")
}

model UserBusiness {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  businessId String   @map("business_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("user_businesses")
}

model UserOAuth {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  email          String
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("user_oauths")
}

model Service {
  id              String        @id @default(uuid())
  name            String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  status          ServiceStatus
  priceDisplayMode Boolean      @default(false) @map("price_display_mode")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  businessServices BusinessService[]
  serviceProviders ServiceProvider[]
  schedulers       Scheduler[]
  contacts         Contact[]
  bookings         Booking[]

  @@map("services")
}

model BusinessService {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  serviceId   String   @map("service_id")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([businessId, serviceId])
  @@map("business_services")
}

model ServiceProvider {
  id          String    @id @default(uuid())
  businessId  String    @map("business_id")
  serviceId   String    @map("service_id")
  userId      String    @map("user_id")
  description String?
  impUrl      String?   @map("imp_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("service_providers")
}

model Scheduler {
  id              String   @id @default(uuid())
  serviceId       String   @map("service_id")
  canScheduleTime Json     @map("can_schedule_time")

  // Relations
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("schedulers")
}

model Contact {
  id          String    @id @default(uuid())
  businessId  String    @map("business_id")
  serviceId   String    @map("service_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  bookingTime Json?     @map("booking_time")
  email       String
  phone       String
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  contactUsers ContactUser[]

  @@map("contacts")
}

model ContactUser {
  id        String  @id @default(uuid())
  contactId String  @map("contact_id")
  userId    String  @map("user_id")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, userId])
  @@map("contact_users")
}

model Booking {
  id                 String            @id @default(uuid())
  businessId         String            @map("business_id")
  userId             String            @map("user_id")
  serviceId          String            @map("service_id")
  serviceProviderId  String            @map("service_provider_id")
  bookingTime        Json?
  status             BookingStatus
  confirmationMethod ConfirmationMethod @map("confirmation_method")
  customerNotes      String?           @db.Text @map("customer_notes")
  bookingSource      BookingSource     @map("booking_source")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @db.Text @map("cancellation_reason")

  // Relations
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@map("bookings")
}
